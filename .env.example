# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Painel do Supabase → Project Settings → API).
# Sem estas variáveis o app roda em "modo demonstração", com os dados salvos só neste aparelho.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica
